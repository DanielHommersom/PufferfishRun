[config]
name="PufferAds"
binary="PufferAds.xcframework"
initialization="puffer_ads_init"
deinitialization="puffer_ads_deinit"

[dependencies]
linked=[]
embedded=["GoogleMobileAds.xcframework", "UserMessagingPlatform.xcframework"]
system=["AppTrackingTransparency.framework", "AdSupport.framework", "JavaScriptCore.framework", "WebKit.framework", "StoreKit.framework"]
capabilities=[]
files=[]
linker_flags=["-ObjC"]

[plist]
GADApplicationIdentifier="ca-app-pub-3366446717708247~5105910064"
NSUserTrackingUsageDescription="We use this to show you relevant ads and improve your experience."
